# ---- Python / tooling
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.venv
.venv-*/
tmp/
downloads_logs/
recovery/

# ---- Model weights and local model copies (re-download from HF; see docs/*PLAN*.md for pins)
models/
*.pt
*.safetensors
*.bin
*.ckpt
*.model
*.npy
*.npz
*.pkl
*.tar

# ---- Corpora and derived pretraining data (tens/hundreds of GB; rebuild with scripts/*)
data/raw/hplt3_vie/
data/raw/fineweb2_vie/
data/raw/wikipedia_vi/
data/mmbert_vi_cpt_pilot/
data/cdbk_dapt_pilot/
data/cpt/
data/cafe_bami_repdistill_pilot/
data/bami_as_cpt_pilot/
# benchmark gold splits (data/raw/uit-*, data/raw/social) stay tracked: small, needed to run

# ---- Artifacts: keep configs/metrics/summaries/reports; drop bulky per-run payloads
artifacts/**/*predictions*.json
artifacts/**/tokenizer.json
artifacts/**/hf/
artifacts/**/hf_*/
artifacts/**/cache/
artifacts/**/.orchestrator/
artifacts/**/*.jsonl

# ---- intent_benchmark: keep manifests/results, drop run dumps
intent_benchmark/runs/
intent_benchmark/handoff/

# ---- derived text corpora and third-party dataset text (research-only licences; rebuild with scripts/)
data/corpus_v1/
data/corpus_v2/
data/cafe_nli_transfer/
data/nli_source_search/

# ---- release bundles, archives and tool zips (hundreds of MB to GB; published via Hugging Face)
releases/
*.zip
*.parquet

# ---- test-set predictions carry gold labels of benchmark test splits (some are no-redistribution)
artifacts/**/predictions/

# ---- run logs
*.log
artifacts/**/logs/

# ---- blind adjudication packet quotes dataset text (research-only licences)
artifacts/label_ceiling_check/adjudication_packet/

# ---- intent benchmark prediction dumps
intent_benchmark/**/*_predictions.jsonl
